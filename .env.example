AI_PROVIDER=unikeyx
AI_API_KEY=
AI_BASE_URL=https://www.unikeyx.com
AI_IMAGE_MODEL=gpt-image-2
AI_LLM_MODEL=gpt-5.5
CHAT_PROVIDER_BASE_URL=https://www.unikeyx.com
CHAT_PROVIDER_API_KEY=
CHAT_PROVIDER_MODEL=gpt-5.6-luna
AI_SANITIZE_MODEL=gpt-5.6-luna
AI_BRIEF_MODEL=gpt-5.6-luna
AI_CONSISTENCY_MODEL=gpt-5.6-luna
# Stable secret used to encrypt image-provider API keys stored in SQLite.
PROVIDER_CONFIG_SECRET=
# Previous encryption secrets, comma-separated, used only during key rotation.
PROVIDER_CONFIG_SECRET_PREVIOUS=
# Stable secrets for signed login sessions and anonymous trial fingerprints.
SESSION_SECRET=
GUEST_USAGE_SECRET=
VITE_API_PORTAL_URL=https://www.unikeyx.com

# Email verification for password registration. Production requires SMTP and a stable secret.
EMAIL_VERIFICATION_SECRET=
EMAIL_VERIFICATION_EXPIRES_MINUTES=10
EMAIL_VERIFICATION_RESEND_SECONDS=60
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_IGNORE_TLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_AUTH_METHOD=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="图简单 Pic365 <no-reply@pic365.org>"

# Local self-owned member system.
APP_DB_PATH=./data/app.sqlite
LOCAL_STORAGE_ROOT=./data/generated

# Azure Blob Storage. For local Azurite debugging use: UseDevelopmentStorage=true
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=generated-images

# Comma-separated emails promoted to super_admin at registration or process startup.
SUPER_ADMIN_EMAILS=

APP_URL=https://www.pic365.org
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Watcha-compatible OAuth login.
WATCHA_CLIENT_ID=
WATCHA_CLIENT_SECRET=
WATCHA_AUTHORIZE_URL=
WATCHA_TOKEN_URL=
WATCHA_USERINFO_URL=
WATCHA_REDIRECT_URI=
WATCHA_PUBLIC_CLIENT=false

# Durable background workers.
FREE_GENERATION_WORKER_CONCURRENCY=12
ECOMMERCE_GENERATION_WORKER_CONCURRENCY=12
ECOMMERCE_GENERATION_USER_CONCURRENCY=3
MEDIA_PROCESSING_WORKER_CONCURRENCY=1

VITE_GA_MEASUREMENT_ID=
GA4_PROPERTY_ID=
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
GOOGLE_ANALYTICS_REFRESH_TOKEN=

# Optional fallback when service account access is available.
GOOGLE_ANALYTICS_CLIENT_EMAIL=
GOOGLE_ANALYTICS_PRIVATE_KEY=

# Local helper only. Add this redirect URI to the Google OAuth client.
GOOGLE_ANALYTICS_REDIRECT_URI=http://localhost:8080/oauth2callback
